<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Match the game's .NET 6 runtime even when global.json selects a newer CI SDK. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the exact shipped rules without redistributing or loading game assemblies. -->
    <Compile Include="../../src/XiangyeShiling/Machines/*.cs" Link="Machines/%(Filename)%(Extension)" />
    <Compile Include="../../src/XiangyeShiling/Transactions/*.cs" Link="Transactions/%(Filename)%(Extension)" />
    <!-- Exercise protocol intent and read-only routing boundaries without loading SMAPI or game assemblies. -->
    <Compile Include="../../src/XiangyeShiling/Networking/*.cs" Link="Networking/%(Filename)%(Extension)" />
    <Compile Include="../../src/XiangyeShiling/Menus/MenuActionSession.cs" Link="Menus/MenuActionSession.cs" />
    <!-- Exercise the actual local harness acceptance gate without loading game assemblies. -->
    <Compile Include="../GameHarness/WorldToolProof.cs" Link="Harness/WorldToolProof.cs" />
    <Compile Include="../GameHarness/KitchenEntryProof.cs" Link="Harness/KitchenEntryProof.cs" />
    <Compile Include="../GameHarness/NetworkProbeEvidence.cs" Link="Harness/NetworkProbeEvidence.cs" />
    <Compile Include="../GameHarness/InputObservationPolicy.cs" Link="Harness/InputObservationPolicy.cs" />
    <Compile Include="../GameHarness/NetworkLifecycleEvidence.cs" Link="Harness/NetworkLifecycleEvidence.cs" />
    <Compile Include="../GameHarness/NetworkWelcomeReplayEvidence.cs" Link="Harness/NetworkWelcomeReplayEvidence.cs" />
    <Compile Include="../../tools/NetworkLifecycleCheck/NetworkLifecycleReportReader.cs" Link="Tools/NetworkLifecycleReportReader.cs" />
    <Compile Include="../../tools/NetworkWelcomeReplayCheck/NetworkWelcomeReplayReportReader.cs" Link="Tools/NetworkWelcomeReplayReportReader.cs" />
  </ItemGroup>
</Project>
